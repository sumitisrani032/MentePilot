# Copy to .env and fill in locally. Never commit .env.

# Local services
DATABASE_URL=postgresql+asyncpg://shopchat_app:shopchat_app@localhost:5432/shopchat
DATABASE_OWNER_URL=postgresql+asyncpg://shopchat_owner:shopchat_owner@localhost:5432/shopchat
REDIS_URL=redis://localhost:6379/0
APP_URL=https://your-public-app-url.example

# Must stay false until an LLM run has been explicitly approved.
LLM_CALLS_ENABLED=false
VOICE_ENABLED=false

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_SMART=gpt-4o-mini
OPENAI_MODEL_EMBEDDING=text-embedding-3-small
OPENAI_MODEL_STT=
OPENAI_MODEL_TTS=

# Shopify app credentials (Partner Dashboard)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2026-10

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
WIDGET_TOKEN_SECRET=
